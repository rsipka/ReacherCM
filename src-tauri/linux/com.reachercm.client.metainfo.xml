<!-- AppStream metadata, read by Linux software centres and the AppImage
     catalog. Installed as usr/share/metainfo/com.reachercm.client.metainfo.xml
     by the AppImage, .deb and .rpm bundles (tauri.conf.json). -->
<component type="desktop-application">
  <id>com.reachercm.client</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Reacher CM</name>
  <summary>SSH client and remote server manager</summary>
  <developer id="com.github.alexandrosnt">
    <name>Alexander Nt.</name>
  </developer>
  <description>
    <p>
      Reacher CM is a personal fork of Reach, a modern SSH client and remote server management tool, with additional features. Free and open source.
    </p>
    <ul>
      <li>Tabbed SSH terminals, jump hosts and port forwarding</li>
      <li>SFTP file browser and system monitoring</li>
      <li>Remote desktop over RDP and VNC</li>
      <li>An encrypted vault for sessions and keys, synced between your devices if you choose</li>
      <li>Ansible and OpenTofu automation, databases and a serial console</li>
    </ul>
  </description>
  <launchable type="desktop-id">ReacherCM.desktop</launchable>
  <url type="homepage">https://github.com/rsipka/ReacherCM</url>
  <url type="bugtracker">https://github.com/rsipka/ReacherCM/issues</url>
  <url type="vcs-browser">https://github.com/rsipka/ReacherCM</url>
  <screenshots>
    <screenshot type="default">
      <caption>Terminals, sessions and the server monitor</caption>
      <image>https://raw.githubusercontent.com/rsipka/ReacherCM/main/assets/preview.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Network</category>
    <category>System</category>
  </categories>
  <content_rating type="oars-1.1" />
