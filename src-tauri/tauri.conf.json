{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "ReacherCM",
  "mainBinaryName": "reachercm",
  "version": "26.11.1-dev.10",
  "identifier": "com.reachercm.client",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Reacher CM",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": [10, 10, 10, 255]
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/rsipka/ReacherCM/update-feed/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Reacher CM",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Alexander Nt. and Reacher CM contributors",
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": { "version": "26.11.1.10" },
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": { "versionCode": 261101010 },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.reachercm.client.metainfo.xml": "linux/com.reachercm.client.metainfo.xml"
        }
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libappindicator3-1"],
        "files": {
          "/usr/share/metainfo/com.reachercm.client.metainfo.xml": "linux/com.reachercm.client.metainfo.xml"
        }
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libappindicator-gtk3"],
        "files": {
          "/usr/share/metainfo/com.reachercm.client.metainfo.xml": "linux/com.reachercm.client.metainfo.xml"
        }
      }
    }
  }
}
